{
  "routes": [
    {
      "src": "/webmail/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/api/webmail-auth",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/((?!api/|webmail/).*)",
      "has": [
        {
          "type": "host",
          "value": "webmail.diegolira.com.br"
        }
      ],
      "dest": "/webmail/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|assets/|favicon\\.svg|robots\\.txt|sitemap\\.xml|webmail/).*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/webmail-ai.js": {
      "maxDuration": 60
    }
  }
}
